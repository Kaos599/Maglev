{
  "expo": {
    "name": "Maglev",
    "slug": "maglev",
    "version": "0.23",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "maglev",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash.png",
      "backgroundColor": "#05070A",
      "resizeMode": "contain"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.maglev.client",
      "icon": "./assets/icon.png"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "monochromeImage": "./assets/adaptive-icon-monochrome.png",
        "backgroundColor": "#0B2A30"
      },
      "predictiveBackGestureEnabled": true,
      "package": "com.maglev",
      "permissions": [
        "INTERNET",
        "ACCESS_NETWORK_STATE",
        "ACCESS_WIFI_STATE",
        "WAKE_LOCK",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_DATA_SYNC",
        "FOREGROUND_SERVICE_SPECIAL_USE",
        "POST_NOTIFICATIONS",
        "REQUEST_IGNORE_BATTERY_OPTIMIZATIONS"
      ],
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "data": [
            {
              "scheme": "magnet"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        },
        {
          "action": "VIEW",
          "data": [
            {
              "mimeType": "application/x-bittorrent"
            },
            {
              "mimeType": "application/x-torrent"
            },
            {
              "scheme": "file",
              "pathPattern": ".*\\.torrent"
            },
            {
              "scheme": "content",
              "pathPattern": ".*\\.torrent"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        },
        {
          "action": "SEND",
          "data": [
            {
              "mimeType": "text/plain"
            },
            {
              "mimeType": "application/x-bittorrent"
            },
            {
              "mimeType": "application/x-torrent"
            }
          ],
          "category": [
            "DEFAULT"
          ]
        },
        {
          "action": "SEND_MULTIPLE",
          "data": [
            {
              "mimeType": "application/x-bittorrent"
            },
            {
              "mimeType": "application/x-torrent"
            }
          ],
          "category": [
            "DEFAULT"
          ]
        }
      ],
      "versionCode": 23
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "./plugins/withAbiSplits.js",
      "./plugins/withSizeReduction.js",
      "./plugins/withShareIntents.js",
      "./plugins/withAppIcons.js",
      "./plugins/withBackupRules.js",
      "./plugins/withCleartextLan.js",
      "./plugins/withReleaseSigning.js",
      "./plugins/withSelfUpdate.js"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
