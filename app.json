{
  "expo": {
    "name": "Maglev",
    "slug": "maglev",
    "version": "0.9",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "maglev",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash.png",
      "backgroundColor": "#05070A",
      "resizeMode": "contain"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.maglev.client",
      "icon": "./assets/icon.png"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#05070A"
      },
      "package": "com.maglev",
      "permissions": [
        "INTERNET",
        "ACCESS_NETWORK_STATE",
        "ACCESS_WIFI_STATE",
        "WAKE_LOCK",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_DATA_SYNC",
        "FOREGROUND_SERVICE_SPECIAL_USE",
        "POST_NOTIFICATIONS",
        "REQUEST_IGNORE_BATTERY_OPTIMIZATIONS"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "data": [
            {
              "scheme": "magnet"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        },
        {
          "action": "VIEW",
          "data": [
            {
              "mimeType": "application/x-bittorrent"
            },
            {
              "mimeType": "application/x-torrent"
            },
            {
              "scheme": "file",
              "pathPattern": ".*\\.torrent"
            },
            {
              "scheme": "content",
              "pathPattern": ".*\\.torrent"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        },
        {
          "action": "SEND",
          "data": [
            {
              "mimeType": "text/plain"
            },
            {
              "mimeType": "application/x-bittorrent"
            },
            {
              "mimeType": "application/x-torrent"
            }
          ],
          "category": [
            "DEFAULT"
          ]
        },
        {
          "action": "SEND_MULTIPLE",
          "data": [
            {
              "mimeType": "application/x-bittorrent"
            },
            {
              "mimeType": "application/x-torrent"
            }
          ],
          "category": [
            "DEFAULT"
          ]
        }
      ],
      "versionCode": 9
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "./plugins/withAbiSplits.js",
      "./plugins/withSizeReduction.js",
      "./plugins/withShareIntents.js",
      "./plugins/withBackupRules.js"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
