  { "note": "multi-episode keeps the first episode", "rule": { "include": "show", "exclude": "", "episodes": "all" }, "title": "Show.S01E01-E03.1080p", "seenEpisodes": [], "expect": { "match": true, "episode": "s1e1" } },
